# 复制为 .env，在自己的编辑器里填写。不要把真实密钥发到聊天或提交 Git。
QQ_APP_ID=
QQ_APP_SECRET=
DEEPSEEK_API_KEY=

# 2026-10-27 核对官方文档；以后可按官方模型列表修改。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=600
DEEPSEEK_TIMEOUT_MS=25000
QQ_API_BASE_URL=https://api.bot.qq.com

# 本地推荐官方长连接（须平台选择WebSocket）；原Webhook方式仍可选。
QQ_TRANSPORT=websocket
STARTUP_GREETING_ENABLED=false
STARTUP_NEWS_ENABLED=false
STARTUP_DATA_DIR=data/startup
STARTUP_GREETING_COOLDOWN_MINUTES=10
STARTUP_NEWS_REFRESH_HOURS=12
# 固定主人称呼，逗号分隔；可能称呼会明确保留不确定性，不用于权限认证。
OWNER_ALIASES=
OWNER_POSSIBLE_ALIASES=
# 只在本机填写不希望被复述的真实姓名，逗号分隔；模型请求与外发文字都会替换。
PRIVATE_NAMES=
OWNER_DISPLAY_NAME=主人

# 2026-10-28 已核对：deepseek-flash 支持图文输入，无需另一个 API Key。
VISION_ENABLED=true
VISION_MODEL=deepseek-flash
MAX_IMAGES_PER_MESSAGE=3
# 单图最多 4 MB；发图通过官方二进制直传，低于 5M 上限。
IMAGE_MAX_BYTES=4000000
IMAGE_TIMEOUT_MS=15000
IMAGE_SEND_ENABLED=true
# 默认使用必应公开图片结果；可改 commons 使用开放授权图库，需要网络可达。
IMAGE_SEARCH_ENABLED=true
IMAGE_SEARCH_PROVIDER=bing
MEME_DATA_DIR=data/memes
MAX_MEMES_PER_GROUP=100

# 回复 @ 对话时偶尔自主配表情；不在无人 @ 时主动插话。
AUTO_MEME_ENABLED=true
# 25% 的回复获得选图机会；模型仍可判断不适合，实际发图会更少。
AUTO_MEME_CHANCE_PERCENT=25
# 同一群至少间隔 5 分钟；每次最多附一张，不连续重复同图（库内有多张时）。
AUTO_MEME_COOLDOWN_SECONDS=300
AUTO_MEME_MAX_OPTIONS=30

# 固定背景及成员身份档案；需要先配置当前群背景。
COMMUNITY_ENABLED=false
COMMUNITY_DATA_DIR=data/community
COMMUNITY_MAX_MEMBERS=500
# 使用同一 DeepSeek Key 查询公开资料，按搜索接口用量计费。
WEB_SEARCH_ENABLED=false
WEB_SEARCH_AUTOMATIC=true
WEB_SEARCH_TIMEOUT_MS=10000

# 0.7：本地学习@对话的常用词与句长，回答时使用短语气指导＋适量emoji。
# 不爬取社交平台、不新增训练调用，不保存学习原句。实际部署可按需开启。
STYLE_ENABLED=false
STYLE_DATA_DIR=data/style
# 普通群文字只在本机记录/学语气；被@时才选少量记录交给模型。
# 需QQ已开启接收所有消息，不会补抓机器人离线前的QQ历史。
GROUP_CHAT_ENABLED=false
GROUP_CHAT_DATA_DIR=data/group-chat
GROUP_CHAT_MAX_MESSAGES=120
GROUP_CHAT_MAX_CHARS=30000
GROUP_CHAT_TTL_HOURS=168
GROUP_CHAT_CONTEXT_CHARS=2200
GROUP_CHAT_CONTEXT_MESSAGES=12
# 打开后同时禁止冷群主动发言和开机招呼；私聊仍独立回复。
GROUP_AT_ONLY=false
# 冷群聊天需订阅 GROUP_MESSAGE_CREATE，并在 QQ 中开启“接收所有消息”、允许主动发送。
# 普通消息只更新活跃时间，不进上下文、不学原话、不调用AI。仍需保留@事件订阅。
IDLE_CHAT_ENABLED=false
# 大于0时为确定性冷群例外，覆盖只@模式、旧概率/时段/日额度；0沿用旧随机模式。
# 例如5：在线完整观察连续5小时无人说话，下一分钟检查时主动发1条，同一冷场只发一次。
IDLE_FORCE_AFTER_HOURS=0
IDLE_DATA_DIR=data/idle
# 需同时打开WEB_SEARCH_ENABLED；共享12小时最多搜索一次，失败回日常话题，不另调聊天模型。
IDLE_NEWS_ENABLED=false
IDLE_NEWS_REFRESH_HOURS=12
IDLE_QUIET_MINUTES=60
IDLE_COOLDOWN_HOURS=4
IDLE_DAILY_MAX=2
IDLE_CHANCE_PERCENT=25
IDLE_CHECK_MINUTES=15
# 固定按北京时间；夜间22～9点不主动发言。
IDLE_START_HOUR=9
IDLE_END_HOUR=22

# 使用事件的 group_openid / author.member_openid，不能填写普通 QQ 群号或 QQ 号。
# 空群名单默认拒绝所有群；首次收到合法事件时，拒绝日志会显示 group_openid。
ALLOWED_GROUP_IDS=
# 留空允许已获准群中的所有成员；填写后仅允许这些 member_openid，逗号分隔。
ALLOWED_USER_IDS=
# 确实要允许机器人已加入的所有群时才改为 true。
ALLOW_ALL_GROUPS=false

# 私聊单独授权，不读取群聊记忆；需QQ后台勾选C2C_MESSAGE_CREATE并有好友/私聊范围。
DM_ENABLED=false
# 开启后允许QQ平台已允许与机器人私聊的用户；仍受全局限流限制。
DM_ALLOW_ALL_USERS=false
# 留空且未开DM_ALLOW_ALL_USERS时拒绝所有私聊；填写user_openid，不是QQ群成员OpenID。
ALLOWED_DM_USER_IDS=
# 基础表达库＋每6小时一次公开搜索和小额模型整理；不读取私人聊天更新网络词汇。
TRENDS_ENABLED=false
TRENDS_DATA_DIR=data/trends
TRENDS_REFRESH_HOURS=6
TRENDS_MAX_TERMS=60

HOST=127.0.0.1
PORT=3000
USER_COOLDOWN_MS=5000
MAX_REQUESTS_PER_MINUTE=20
MAX_CONCURRENT_REQUESTS=2
MAX_INPUT_CHARS=2000
MAX_REPLY_CHARS=1200
# 同一群共享 @ 对话；改为 member 则同一群内每人分别记忆。
CONTEXT_SCOPE=group
# 超过 10 轮或文本预算后，将旧问答整理成摘要；0 关闭上下文。
CONTEXT_MAX_TURNS=10
# 0 不自动过期；持久化后重启也能恢复。
CONTEXT_TTL_MINUTES=0
CONTEXT_MAX_CHARS=12000
# 只限制常驻内存缓存数量，卸载缓存不会删除磁盘记忆。
CONTEXT_MAX_SESSIONS=500
CONTEXT_PERSIST=true
CONTEXT_DATA_DIR=data/memory
CONTEXT_AUTO_COMPACT=true
CONTEXT_RECENT_TURNS=4
CONTEXT_SUMMARY_MAX_CHARS=2400
CONTEXT_SUMMARY_MAX_TOKENS=1000
# 留空使用 DEEPSEEK_MODEL；摘要会增加少量 API 调用。
CONTEXT_SUMMARY_MODEL=
CONTEXT_COMPACT_BATCH_CHARS=24000
CONTEXT_COMPACT_RETRY_SECONDS=60
CONTEXT_MAX_PENDING_CHARS=120000
SYSTEM_PROMPT="你是 QQ 群里的 AI 助手。用简洁中文回答，尽量控制在 500 字以内。不要声称自己执行了外部操作。"
